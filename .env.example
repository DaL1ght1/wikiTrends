# Copy to `.env` and adjust. Every value has a default in docker-compose.yml,
# so the stack also starts without a .env file.

# --- Wikimedia EventStreams ------------------------------------------------
EVENTSTREAM_URL=https://stream.wikimedia.org/v2/stream/recentchange
# Wikimedia asks every client to send a descriptive User-Agent with contact info.
# https://meta.wikimedia.org/wiki/User-Agent_policy
USER_AGENT=wikitrends-pipeline/2.0 (https://github.com/DaL1ght1/wikiTrends; contact=you@example.com)

# --- Kafka -----------------------------------------------------------------
KAFKA_BOOTSTRAP=kafka:9092
INPUT_TOPIC=wikimedia.recentchange.raw
CLEAN_TOPIC=wikimedia.recentchange.clean
TREND_TOPIC_1M=trending.windows.1m
TREND_TOPIC_5M=trending.windows.5m

# --- Stream aggregator -----------------------------------------------------
# Comma-separated namespace ids to keep (0 = articles). Empty = keep all.
NAMESPACES=0
# Aggregate bot edits separately for the UI's bot section (false = drop them).
# The trending list itself always uses human edits only.
TRACK_BOTS=true
WATERMARK=1 minute
TRIGGER_EVERY=10 seconds

# --- OpenSearch ------------------------------------------------------------
OPENSEARCH_URL=http://opensearch:9200
INDEX_1M=trending-1m
INDEX_5M=trending-5m
# Days of window documents OpenSearch keeps before ISM deletes the index.
RETENTION_DAYS=7

# --- Alerts ----------------------------------------------------------------
# A page alerts when its z-score reaches ALERT_MIN_Z with ALERT_MIN_EDITORS+
# distinct editors; a story alerts when ALERT_MIN_LANGUAGES+ editions surge.
ALERTS_ENABLED=true
ALERT_MIN_Z=5
ALERT_MIN_EDITORS=2
ALERT_MIN_LANGUAGES=3
ALERT_COOLDOWN_MINUTES=60
# Slack or Discord incoming-webhook URL. Leave empty to only show alerts in the UI.
ALERT_WEBHOOK_URL=
# Link included in webhook messages.
PUBLIC_UI_URL=http://localhost:8000

# --- Baseline batch job ----------------------------------------------------
# How often the baseline job recomputes per-page edit-rate statistics.
BASELINE_INTERVAL_HOURS=6

# --- Resources -------------------------------------------------------------
SPARK_WORKER_MEMORY=3G
SPARK_WORKER_CORES=3
