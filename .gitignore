# ============================================
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
*.py,cover
.hypothesis/

# ============================================
# Documentation Builds
# ============================================
docs/_build/
site/

# ============================================
# Project Specific
# ============================================
# Backup files
*.bak
*.backup

# Archive files
*.zip
*.tar.gz
*.tar
*.rar
*.7z

# Large binary files (unless tracked with LFS)
*.bin
*.dat

# Compiled Java/Scala (if any)
*.class
target/

# Node modules (if any frontend)
node_modules/
package-lock.json
yarn.lock

# ============================================
# Keep These Files (force include)
# ============================================
# Keep empty directories
!.gitkeep

# Keep configuration templates
!conf/**/*.example
!*.template