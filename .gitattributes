# Scripts and configs run inside Linux containers: always use LF line endings,
# even when the repo is checked out on Windows with core.autocrlf=true.
* text=auto eol=lf
*.sh text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
Dockerfile text eol=lf
*.png binary
*.jpg binary
