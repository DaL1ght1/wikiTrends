{
  "index_patterns": ["trending-bots-5m-*"],
  "priority": 100,
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "refresh_interval": "5s",
      "index.default_pipeline": "trending-ingest"
    },
    "aliases": {
      "trending-bots-5m": {}
    },
    "mappings": {
      "dynamic": "false",
      "properties": {
        "ts_bucket":     {"type": "date"},
        "window_start":  {"type": "date"},
        "last_event_ts": {"type": "date"},
        "indexed_at":    {"type": "date"},
        "window_size":   {"type": "keyword"},
        "kind":          {"type": "keyword"},
        "wiki":          {"type": "keyword"},
        "server_name":   {"type": "keyword"},
        "user":          {"type": "keyword"},
        "edit_count":    {"type": "integer"},
        "pages":         {"type": "integer"},
        "new_pages":     {"type": "integer"},
        "sum_abs_delta": {"type": "long"}
      }
    }
  },
  "_meta": {"owner": "wikitrends", "content": "per-bot-account activity, 5-minute windows"}
}
