{
  "uid": "wikitrends-main",
  "title": "Wikimedia Trending Topics",
  "description": "Live trending Wikipedia pages. For the richer interactive view open the WikiTrends UI at http://localhost:8000.",
  "tags": [
    "wikimedia",
    "trending"
  ],
  "editable": true,
  "graphTooltip": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "schemaVersion": 39,
  "version": 2,
  "links": [
    {
      "title": "WikiTrends UI",
      "type": "link",
      "url": "http://localhost:8000",
      "targetBlank": true,
      "icon": "external link"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "wiki",
        "label": "Wiki",
        "type": "query",
        "datasource": {
          "type": "grafana-opensearch-datasource",
          "uid": "opensearch-1m"
        },
        "query": "{\"find\": \"terms\", \"field\": \"wiki\", \"size\": 200}",
        "includeAll": true,
        "allValue": "*",
        "multi": false,
        "refresh": 2,
        "sort": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Edits per minute",
      "description": "Average over the time range. Each point is the sum of one 1-minute window across all pages (no double counting).",
      "datasource": {
        "type": "grafana-opensearch-datasource",
        "uid": "opensearch-1m"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "mean"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#2a78d6"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-opensearch-datasource",
            "uid": "opensearch-1m"
          },
          "refId": "A",
          "query": "wiki:$wiki AND NOT actor:bot",
          "queryType": "lucene",
          "timeField": "ts_bucket",
          "metrics": [
            {
              "id": "1",
              "type": "sum",
              "field": "edit_count"
            }
          ],
          "bucketAggs": [
            {
              "id": "2",
              "type": "date_histogram",
              "field": "ts_bucket",
              "settings": {
                "interval": "30s",
                "min_doc_count": "0",
                "trimEdges": "1"
              }
            }
          ],
          "alias": ""
        }
      ]
    },
